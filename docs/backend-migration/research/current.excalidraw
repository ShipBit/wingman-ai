   "link": null,
   "locked": false,
   "text": "Azure AD B2C\nCustom Policies (B2C_1A_SIGNUP_SIGNIN_SHIPBIT)\n\nIdPs: Google, GitHub, E-Mail/Passwort\n10 Extension-Attribute = Subscription-Kopie:\nWingmanSubscriptionPlan, PayProSubscriptionId,\nPayProSubscriptionEndDate, LastPayProSubscriptionPlan,\nPaddleUserId, StripeCancelDate, TermsConsentDateTime …",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rectangle_c_2c2fat",
   "originalText": "Azure AD B2C\nCustom Policies (B2C_1A_SIGNUP_SIGNIN_SHIPBIT)\n\nIdPs: Google, GitHub, E-Mail/Passwort\n10 Extension-Attribute = Subscription-Kopie:\nWingmanSubscriptionPlan, PayProSubscriptionId,\nPayProSubscriptionEndDate, LastPayProSubscriptionPlan,\nPaddleUserId, StripeCancelDate, TermsConsentDateTime …",
   "autoResize": true,
   "lineHeight": 1.25
  },
